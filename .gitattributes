Makefile linguist-detectable=false

# Should not affect language stats
.project/** linguist-vendored

# Keep local/manual/archive project material in the repo,
# but exclude it from git archive exports used for external review/release packages.
.project/local/** export-ignore
.project/manual-tests/** export-ignore
.project/tasks/archive/** export-ignore
old-files/** export-ignore

# Test data / parser fixtures should not affect language stats
tests/data/** linguist-vendored

# Documentation
docs/** linguist-documentation

# Make sure Rust is counted normally
*.rs linguist-language=Rust
